{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcp-research:target-summary:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "scenario_id", "phase", "scenario_sha256", "source_trace_sha256", "target"],
  "properties": {
    "schema_version": {"const": "xcp-research-target-summary-v1"},
    "snapshot_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "phase": {"enum": ["calibration", "validation", "holdout"]},
    "scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "worker_artifact_sha256", "project_sha256", "execution_status", "lifecycle_operations", "lifecycle_receipt_sha256", "observation_evidence_sha256", "trace_sha256"],
      "properties": {
        "class": {"const": "constrained Xbox Series X public-UWP candidate"},
        "worker_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_status": {"const": "complete_for_scenario"},
        "lifecycle_operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "total"],
          "properties": {
            "passed": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1}
          }
        },
        "lifecycle_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observation_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
